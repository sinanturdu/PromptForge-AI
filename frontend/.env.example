# Local Vite development proxy target for `/api` requests (`npm run dev`).
# Never place secret API keys or credentials in VITE_* variables; they are public in browser builds.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Legacy PromptRequest base override only; separate-origin workflow deployment is unsupported.
# Keep empty in every loaded Vite mode file for the verified local same-origin SPA.
# Workflow requests always use relative /api/v1; Vite deliberately denies workflow proxy paths.
VITE_API_BASE_URL=
