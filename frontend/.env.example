# Local Vite development proxy target for `/api` requests (`npm run dev`).
# Never place secret API keys or credentials in VITE_* variables; they are public in browser builds.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional explicit API origin override for separate-origin deployments.
# Leave empty during local development so `/api/v1/*` routes through the Vite `/api` proxy without CORS issues.
VITE_API_BASE_URL=
