# Local development configuration for PromptForge AI backend.
# Copy to backend/.env to customize locally. Never commit backend/.env.

# Listener host/port are CLI options, not APP_HOST/APP_PORT Settings.
# Complete setup and configuration: ../docs/local-mvp-setup.md and
# ../docs/local-mvp-operations.md. Never target personal data for qualification.
# APP_NAME=PromptForge AI
# APP_VERSION=0.0.1
# API_V1_PREFIX=/api/v1

# Structured JSON logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum allowed HTTP request body size in bytes (262144 = 256 KiB).
MAX_REQUEST_BODY_BYTES=262144

# Optional database override. When omitted, defaults to an absolute path at:
# sqlite+aiosqlite:///<backend_dir>/data/promptforge.db
# Use the setup guide to generate an absolute URL for a NEW dedicated SQLite file.
# Workflow read/execution requires file-based SQLite, not :memory: or PostgreSQL.
# Dedicated execution --database overrides this setting and refuses the default DB.
DATABASE_CONNECT_TIMEOUT=30.0
DATABASE_ECHO=false

# Workflow reads: direct loopback/same-origin only. Both flags default off.
# Execution requires BOTH flags AND qualified app.core.execution_startup.
# Ordinary Uvicorn cannot execute, even with both flags true.
WORKFLOW_API_ENABLED=false
WORKFLOW_EXECUTION_ENABLED=false

# Internal LLM execution provider (independent of the saved prompt's target_mode).
# Fake requires no key; the stock CLI fake has an empty script and safely fails generation.
# Successful offline workflows use explicitly scripted fake test fixtures.
# OpenAI is backend-only; configuration never authorizes execution by itself.
LLM_PROVIDER=fake
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_CALL_DEADLINE_SECONDS=90
# Hard operation-wide caps: retries 0-2, JSON repair requests 0-1.
LLM_MAX_RETRIES=2
LLM_JSON_REPAIR_ATTEMPTS=1
# For explicit backend-only OpenAI use, supply OPENAI_API_KEY through your environment.
# No default model: dedicated startup requires --architect-model and --critic-model.
# Never store keys in VITE_* or commit real .env files; no real key example belongs here.
