# =============================================================
# PromptForge AI - Git ignore rules
# =============================================================

# ---------- Secrets and local environment ----------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-eggs/
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# Python tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ---------- Node / Frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.tsbuildinfo
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- Databases ----------
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal

# ---------- Logs and temporary files ----------
logs/
*.log
tmp/
temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ---------- Editors and IDEs ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.code-workspace

# ---------- Operating systems ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Playwright E2E ----------
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.playwright/

# ---------- Offline benchmark reports ----------
backend/benchmark-reports/
